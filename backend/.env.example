XC_API_KEY=tu_api_key_aqui
GOOGLE_APPLICATION_CREDENTIALS=ruta/a/tu/llave-servicio.json
GCP_KEY_PATH=ruta/a/tu/llave-servicio.json
GCS_BUCKET_NAME=nombre-del-bucket-gcs
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fama_db

# Autenticación: clave única y aleatoria, al menos 32 bytes UTF-8. Sin default.
JWT_SECRET_KEY=

# Alta inicial: solo para una BD sin usuarios; contraseña distinta de la antigua
# contraseña pública y de al menos 12 caracteres. No cambia cuentas existentes.
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=
# ADMIN_INITIAL_NAME=Nombre del administrador
