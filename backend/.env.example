XC_API_KEY=
# ADC por defecto; declarar un archivo solo si el operador lo necesita.
# En Docker, la ruta debe existir dentro de /run/fama/credentials.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
GCP_KEY_PATH=
GCS_BUCKET_NAME=
DATABASE_URL=
# Alternativa: archivo protegido con URL completa, ruta absoluta.
# DATABASE_URL_FILE=
# Estado persistente del nodo (ruta absoluta, protegida por el operador).
# FAMA_CONFIG_DIR=
# Archivos del nodo: raíz absoluta preparada mediante app.node runtime --directory.
# FAMA_RUNTIME_DIR=

# Autenticación: clave única y aleatoria, al menos 32 bytes UTF-8. Sin default.
JWT_SECRET_KEY=
# JWT_SECRET_KEY_FILE=
FAMA_RATE_LIMIT_KEY=
# FAMA_RATE_LIMIT_KEY_FILE=
FAMA_WEB_ORIGIN=
FAMA_ALLOW_INSECURE_LOOPBACK=
FAMA_SESSION_MAX_AGE_SECONDS=28800
FAMA_SESSION_IDLE_SECONDS=1800

# Compatibilidad con seed_initial_admin() explícito del operador.
# El arranque normal ya no crea cuentas; el asistente llegará en la etapa 7.
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=
# ADMIN_INITIAL_NAME=Nombre del administrador
